# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RECEIPT_DOC_URL: Optional Google Doc with numbered receipt pages (page # = space #).
# Paste your doc URL here or configure it in the Sites tab.
RECEIPT_DOC_URL=""

# ADMIN_PASSWORD: Bootstrap password for /admin (back office).
# Prefer changing the password in Admin Settings (stored as scrypt hash, min 12 chars).
# Falls back to PREVIEW_PASSWORD, then "pineflats" if unset — never leave defaults in production.
ADMIN_PASSWORD="change-me-to-a-strong-password-12plus"

# --- Google Connect (Calendar / Sheets / Docs) — YOUR account, not Empire Firebase ---
# Create an OAuth 2.0 Web Client ID in Google Cloud Console under the Gmail you own:
#   https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://pineflatsrvpark.com , https://www.pineflatsrvpark.com , http://localhost:3000
# Either set VITE_GOOGLE_CLIENT_ID here (rebuild required) or put clientId in google-oauth-config.json
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# PREVIEW_PASSWORD: Legacy alias; used only if ADMIN_PASSWORD is not set.
PREVIEW_PASSWORD="change-me"

# CARD_DATA_KEY: Secret used to encrypt saved card metadata at rest (AES-256-GCM).
# Generate a long random string (32+ chars). Never commit the real key.
# Full card numbers and CVV are never stored — only encrypted last-4 + expiry + name.
CARD_DATA_KEY="replace-with-a-long-random-secret"

# --- Payment processor (card charges — connect later) ---
# Choose provider in Admin → Settings → Payment processor (public key, enable, test mode).
# Secret keys stay here only — never put them in the admin form or data/*.json.
# PAYMENT_PROCESSOR_PROVIDER=stripe
# PAYMENT_PROCESSOR_SECRET_KEY=sk_test_...
# PAYMENT_PROCESSOR_WEBHOOK_SECRET=whsec_...
# Webhook path (public): POST /api/payment-processor/webhook
# Charge helper (admin): POST /api/payment-processor/charge  (returns not_configured until wired)

# --- Receipt emails (customer + Pine Flats) ---
# Sent when: (1) public website booking completes, (2) admin records a tenant payment.
# Without SMTP, receipts are written to data/email-log.json (payment/booking still succeeds).
# Prefer Admin → Settings → Email/SMTP (stored in data/config.json).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Pine Flats RV Park <info@pineflatsrv.com>"
# PARK_NOTIFY_EMAIL=info@pineflatsrv.com
# (PARK_NOTIFY_EMAIL defaults to Settings → Website contact email if unset.)

# --- SMS booking alerts (Twilio) ---
# Text when a guest completes an online booking. Prefer Admin → Settings → SMS alerts.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+15551234567
# PARK_SMS_TO=+15415551212

